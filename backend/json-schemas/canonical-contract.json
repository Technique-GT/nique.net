[
  {
    "collection": "categories",
    "validationLevel": "moderate",
    "validationAction": "error",
    "validator": {
      "$jsonSchema": {
        "bsonType": "object",
        "required": ["_id", "__v", "name", "slug"],
        "properties": {
          "_id": { "bsonType": "objectId" },
          "__v": { "bsonType": ["int", "long", "double", "decimal"] },
          "name": { "bsonType": "string" },
          "slug": { "bsonType": "string" }
        }
      }
    }
  },
  {
    "collection": "tags",
    "validationLevel": "moderate",

# MongoDB Atlas connection string
ATLAS_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name (use "test" for development, NEVER "technique")
MONGO_DB_NAME=test

# Server port
PORT=5050

# JWT secret for authentication
JWT_SECRET=your-secret-key-here
JWT_TOKEN=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development

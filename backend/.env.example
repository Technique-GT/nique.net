# MongoDB Atlas connection string
ATLAS_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Database name (use "test" for development, NEVER "technique")
MONGO_DB_NAME=test

# Server port
PORT=5050

# JWT secret for authentication
JWT_SECRET=your-secret-key-here
JWT_TOKEN=your-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5050/api/auth/google/callback

# Frontend/dashboard URLs for CORS (comma-separated)
CLIENT_URLS=http://localhost:5173,http://localhost:5174

# Public API URL exposed through Cloudflare proxy (production)
PUBLIC_API_BASE_URL=https://api.nique.net/api

# Cloudflare cache purge configuration
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PURGE_ENABLED=false

# Cloudflare R2 (S3-compatible object storage for media uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=media
R2_PUBLIC_URL=https://media.nique.net

# Environment
NODE_ENV=development

{
  "name": "technique",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\" \"npm --prefix dashboard run dev\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "dev:dash": "npm --prefix dashboard run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build && npm --prefix dashboard run build",
    "start": "concurrently \"npm run start:api\" \"npm run start:web\" \"npm run start:dash\"",
    "start:api": "npm --prefix backend run start",
    "start:web": "npm --prefix frontend run preview",
    "start:dash": "npm --prefix dashboard run preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "esbuild": "0.25.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "react-virtuoso": "^4.18.1",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0"
  }
}
